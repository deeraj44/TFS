# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/farmers-story

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Support / order notification mailbox
ORDER_NOTIFY_EMAIL=order.thefarmerstory@gmail.com

# SMTP (used by utils/mailer.js — plug in real credentials in production,
# e.g. Gmail App Password, SendGrid, Postmark, SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=order.thefarmerstory@gmail.com
SMTP_PASS=your_app_password_here

# Merchant UPI ID shown at checkout
UPI_ID=thefarmerstory@upi
